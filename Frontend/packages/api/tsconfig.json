{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@mealrelay/types": ["../types/src/index.ts"],
      "@mealrelay/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
