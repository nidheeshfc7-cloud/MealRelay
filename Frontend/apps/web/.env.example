# FastAPI Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# If you want to connect to a live Supabase PostgreSQL database:
# 1. Create a project at https://supabase.com
# 2. Run the SQL schema from: packages/api/schema.sql in the Supabase SQL editor
# 3. Copy this file to .env.local and fill in your Supabase credentials below:

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...


# Supabase Auth (required for protected routes and auth actions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is supported instead of the publishable key.
AUTH_SITE_URL=http://localhost:3000
