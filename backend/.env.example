# ==============================================================================
# MealRelay Backend — Environment Configuration (.env.example)
# ==============================================================================
# NOTE: All variables below are OPTIONAL.
# If omitted or left blank, MealRelay automatically runs in Offline Edge Mode
# (in_memory_edge), keeping all meal records and machine learning models in-memory
# with zero external internet dependencies or API keys required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Cloud Persistence (Optional)
# ------------------------------------------------------------------------------
# Only required if you want meal logs to persist to a cloud database across restarts.
# In local development or hackathon demos, leaving these blank runs purely in-memory.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. Server Runtime Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 3. Thread-Safe Math Library Settings (Handled automatically in config.py)
# ------------------------------------------------------------------------------
# Enforces single-core execution to prevent OpenBLAS thread allocation issues on Windows/edge hardware
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
OMP_NUM_THREADS=1
